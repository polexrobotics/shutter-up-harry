---
// The header on every page. `overlay` sits it on top of a photo (landing page banner).
import site from '../site.config.js';
const { current = '', overlay = false } = Astro.props;
const links = [['map', '/map/', 'Map'], ['places', '/places/', 'Places'], ['about', '/about/', 'About'], ['contact', '/contact/', 'Contact']];
---
<header class:list={['site-header', { overlay }]}>
  <a class="sh-brand" href="/" aria-label={`${site.name}, home`}>
    <b>{site.name}</b><span>{site.tagline}</span>
  </a>
  <nav class="sh-nav" id="siteNav" aria-label="Main">
    {links.map(([k, href, label]) => <a href={href} aria-current={current === k ? 'page' : undefined}>{label}</a>)}
    <a class="sh-ig" href={site.instagram} rel="noopener" target="_blank" aria-label={`${site.handle} on Instagram`}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/></svg>
      <span class="sh-ig-label">Instagram</span>
    </a>
  </nav>
  <button class="sh-menu" aria-expanded="false" aria-controls="siteNav" aria-label="Menu">
    <span></span><span></span>
  </button>
</header>
<script>
  const h = document.querySelector('.site-header');
  const b = h?.querySelector('.sh-menu');
  b?.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') !== 'true';
    b.setAttribute('aria-expanded', String(open)); h.classList.toggle('menu-open', open);
    document.documentElement.classList.toggle('no-scroll', open);
  });
  // Solid background once the banner scrolls away.
  if (h?.classList.contains('overlay')) {
    const on = () => h.classList.toggle('scrolled', scrollY > 40);
    addEventListener('scroll', on, { passive: true }); on();
  }
</script>
