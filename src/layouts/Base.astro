---
import '../styles/site.css';
import site from '../site.config.js';
const { title, description = `${site.name}: ${site.tagline}. Photographs on a map, from ${site.location} and further afield.`, image, bodyClass = '' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#d6dfe3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1417" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
    <style is:global>
      body{margin:0;-webkit-font-smoothing:antialiased}
      [hidden]{display:none!important}
      img{max-width:100%}
      :root{padding-top:0}
    </style>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
